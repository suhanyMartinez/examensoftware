// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CLOSED
  CANCELLED
}

enum ProjectCategory {
  DESIGN
  DEVELOPMENT
  MARKETING
  WRITING
  VIDEO
  PHOTOGRAPHY
  CONSULTING
  OTHER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  password  String?
  role      UserRole   @default(CLIENT)
  isActive  Boolean    @default(true)

  // Campos específicos del perfil
  phone     String?
  bio       String?
  location  String?

  // Relaciones
  projects      Project[]
  proposals     Proposal[]  @relation("freelancer")
  receivedProposals Proposal[] @relation("client")

  // NextAuth
  accounts  Account[]
  sessions  Session[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String            @id @default(cuid())
  title       String
  description String
  category    ProjectCategory   @default(OTHER)
  budget      Float
  status      ProjectStatus     @default(ACTIVE)

  // Relación con cliente
  clientId    String
  client      User              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relación con propuestas
  proposals   Proposal[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Proposal {
  id            String          @id @default(cuid())
  title         String
  description   String
  bidAmount     Float
  status        ProposalStatus  @default(PENDING)

  // Relación con freelancer (quien envía la propuesta)
  freelancerId  String
  freelancer    User            @relation("freelancer", fields: [freelancerId], references: [id], onDelete: Cascade)

  // Relación con proyecto
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relación con cliente (quien recibe la propuesta)
  clientId      String
  client        User            @relation("client", fields: [clientId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([freelancerId, projectId])
}

